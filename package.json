{
  "name": "@immediately-run/dev-fs",
  "version": "0.4.0",
  "description": "Vite plugin that bridges immediately.run's async `fs` module (and Firestore-backed spaces) to your local disk during `vite dev`.",
  "type": "module",
  "license": "MIT",
  "author": "immediately.run",
  "homepage": "https://github.com/immediately-run/dev-fs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/immediately-run/dev-fs.git"
  },
  "bugs": {
    "url": "https://github.com/immediately-run/dev-fs/issues"
  },
  "keywords": [
    "vite-plugin",
    "immediately.run",
    "fs",
    "zenfs",
    "filesystem",
    "dev"
  ],
  "exports": {
    ".": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./fs": {
      "types": "./fs.d.ts"
    },
    "./client-fs.js": "./client-fs.js",
    "./client-spaces.js": "./client-spaces.js",
    "./package.json": "./package.json"
  },
  "main": "./dist/plugin.js",
  "types": "./dist/plugin.d.ts",
  "files": [
    "dist",
    "fs.d.ts",
    "client-fs.js",
    "client-spaces.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node scripts/check-fs-types.mjs",
    "test:selftest": "node scripts/check-fs-types.mjs --self-test"
  },
  "peerDependencies": {
    "@immediately-run/sdk": ">=0.49.0"
  },
  "devDependencies": {
    "@immediately-run/dev-fs": "file:",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0",
    "vite": ">=5"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "@immediately-run/sdk": {
      "optional": true
    }
  }
}
